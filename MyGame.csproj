<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HitThemAll</AssemblyName>
    <RootNamespace>HitThemAll</RootNamespace>
  </PropertyGroup>

  <!-- Publish settings: `dotnet publish -c Release -r win-x64` (or osx-arm64 / osx-x64 / linux-x64)
       produces one self-contained exe (no .NET install needed). No RID is set here so `dotnet run` works on any OS. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed> <!-- SaveData uses reflection-based System.Text.Json -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="tile.png" CopyToOutputDirectory="Always" />
    <None Include="assets\dungeon.tmx" CopyToOutputDirectory="Always" />
    <None Include="textures\**" CopyToOutputDirectory="Always" />
    <None Include="sounds\**" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

</Project>

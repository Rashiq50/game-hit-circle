<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HitThemAll</AssemblyName>
    <RootNamespace>HitThemAll</RootNamespace>
  </PropertyGroup>

  <!-- Keep a console attached during local development so Console.WriteLine and debug output are visible when running with `dotnet run`.
       Release builds can still be packaged as a GUI app if needed. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputType>WinExe</OutputType>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed> <!-- SaveData uses reflection-based System.Text.Json -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="tile.png" CopyToOutputDirectory="Always" />
    <None Include="assets\dungeon.tmx" CopyToOutputDirectory="Always" />
    <None Include="textures\**" CopyToOutputDirectory="Always" />
    <None Include="sounds\**" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

</Project>
